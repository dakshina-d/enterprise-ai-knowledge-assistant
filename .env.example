BM25_MAX_INDEXED_CHUNKS=10000
HYBRID_DENSE_WEIGHT=0.65
HYBRID_SPARSE_WEIGHT=0.35
HYBRID_OVERFETCH_FACTOR=4
HYBRID_MAX_CANDIDATES=100
HYBRID_DENSE_TIMEOUT_SECONDS=30
HYBRID_SPARSE_TIMEOUT_SECONDS=5
HYBRID_ALLOW_PARTIAL_RESULTS=true
GRAPH_MAX_STEPS=20
