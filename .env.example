# Proof-of-concept authentication. Prefer `python scripts/create_demo_env.py`; never commit output.
AUTH_ENABLED=false
AUTH_TOKEN_SECRET=
AUTH_TOKEN_ALGORITHM=HS256
AUTH_TOKEN_EXPIRY_MINUTES=30
AUTH_TOKEN_ISSUER=enterprise-ai-knowledge-assistant
