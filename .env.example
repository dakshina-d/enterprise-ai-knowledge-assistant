OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=800
OLLAMA_TEMPERATURE=0
OLLAMA_KEEP_ALIVE=5m
OPENAI_API_KEY=
