GRAPH_TIMEOUT_SECONDS=30
GRAPH_MAX_MESSAGES=20
GRAPH_MAX_MESSAGE_CHARACTERS=20000
GRAPH_MAX_EVIDENCE_ITEMS=20
GRAPH_MAX_WARNINGS=20
GRAPH_MAX_ERRORS=10
GRAPH_CHECKPOINT_MODE=memory
