MEMORY_SESSION_TTL_SECONDS=7200
MEMORY_MAX_CONTEXT_TOPICS=20
MEMORY_MAX_CONTEXT_IDENTIFIERS=30
MEMORY_FOLLOWUP_CONTEXT_ENABLED=true
MEMORY_REDACT_SENSITIVE_PATTERNS=true
PYTHON_ANALYSIS_ENABLED=true
PYTHON_ANALYSIS_MAX_ROWS=1000
PYTHON_ANALYSIS_MAX_GROUPS=100
PYTHON_ANALYSIS_MAX_RESULT_ITEMS=50
PYTHON_ANALYSIS_MAX_FILTER_VALUES=50
