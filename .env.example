APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGCHAIN_TRACING_V2=false
MCP_SERVER_URL=

# Proof-of-concept authentication. Generate hashes locally; never commit passwords.
AUTH_ENABLED=false
AUTH_TOKEN_SECRET=
AUTH_TOKEN_ALGORITHM=HS256
AUTH_TOKEN_EXPIRY_MINUTES=30
AUTH_TOKEN_ISSUER=enterprise-ai-knowledge-assistant
AUTH_TOKEN_AUDIENCE=enterprise-ai-knowledge-assistant-api
DEMO_VIEWER_USERNAME=demo-viewer
DEMO_VIEWER_PASSWORD_HASH=
DEMO_ANALYST_USERNAME=demo-analyst
DEMO_ANALYST_PASSWORD_HASH=
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_PASSWORD_HASH=

# Rate limiting is disabled only for explicit local/test use. Keep enabled in deployments.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_PER_SECOND=0.0333333333
RATE_LIMIT_LOGIN_COST=1
RATE_LIMIT_STANDARD_CAPACITY=30
RATE_LIMIT_STANDARD_REFILL_PER_SECOND=0.5
RATE_LIMIT_STANDARD_COST=1
RATE_LIMIT_EXPENSIVE_CAPACITY=10
RATE_LIMIT_EXPENSIVE_REFILL_PER_SECOND=0.0666666667
RATE_LIMIT_EXPENSIVE_COST=2
RATE_LIMIT_BUCKET_TTL_SECONDS=3600
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOSTS=
